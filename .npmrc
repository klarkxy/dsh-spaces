# DSH Spaces install policy.
#
# Keep the hoisted node_modules layout used by official DSH profiles and by
# scripts/build-spaces.mjs when staging playwright-core into ui-engine.
node-linker=hoisted

# Retained for fallback compatibility if an external Git consumer invokes npm:
# `@klarkxy/dsh-dev-index` declares `@deepseek-ai/*` peers like `>=0.2.0-rc.2`
# which npm's default prerelease peer gate would otherwise reject against `0.2.2-rc.1`.
legacy-peer-deps=true
