# DSH Spaces dev install policy.
#
# `@klarkxy/dsh-dev-index` (bundled by @dsh-spaces/plugin and
# @dsh-spaces/view-bridge) declares `@deepseek-ai/*` peers like
# `>=0.2.0-rc.2`. npm's default peer resolution (npm >= 10) excludes
# prerelease versions the range does not explicitly name, so it rejects
# `0.2.2-rc.1` for `>=0.2.0-rc.2` even though the official DSH
# compatibility check (`@deepseek-ai/dsh-app-boot`
# `evaluatePluginCompatibility`, `semver.satisfies(range,
# {includePrerelease: true})`) accepts it — verified against the actual
# `dsh@0.2.2-rc.1` CLI and profile boot. The peer graph is contractually
# valid; only npm's stricter default gate blocks it.
#
# Use `--legacy-peer-deps` semantics for this repository's `npm install`/`ci`
# so development and CI resolve the pinned tree without `--force` (which would
# mask conflicts rather than describe this one pre-release peer contract).
# This is limited to workspace installs; the runtime `dsh plugin add` path
# uses pnpm inside each managed profile (hoisted layout, no strict peer gate).
legacy-peer-deps=true
