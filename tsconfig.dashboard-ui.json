{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "react", "react-dom"]
  },
  "include": ["src/shared/dashboard.ts", "src/core/domain/dashboard/**/*.ts", "packages/dashboard/src/**/*.ts", "packages/dashboard/src/**/*.tsx", "tests/dashboard-local.test.ts", "tests/dashboard-view.test.tsx"]
}
