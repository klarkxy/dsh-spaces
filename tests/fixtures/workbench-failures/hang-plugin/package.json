{
  "name": "@dsh-spaces/hang-fixture",
  "version": "0.0.0-test",
  "description": "Isolated workbench start-timeout fixture. Host apply hangs with cooperative stop; client keeps data-dsh-boot. Not a product plugin.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml"],
  "dsh": {
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-renderer"],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
