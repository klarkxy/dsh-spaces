{
  "name": "@dsh-spaces/dashboard",
  "version": "0.1.0-alpha.1",
  "description": "Composable local dashboard for a native DSH Web host",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "repository": { "type": "git", "url": "git+https://github.com/klarkxy/dsh-spaces.git", "directory": "packages/dashboard" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-client-connection": ">=0.1.7-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.7-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.7-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.7-alpha.1 <0.2.0"
  }
}
