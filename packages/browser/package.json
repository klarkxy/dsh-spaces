{
  "name": "@dsh-spaces/browser",
  "version": "0.4.0",
  "license": "MIT",
  "description": "Standalone Browser Space plugin for DSH Spaces",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarkxy/dsh-spaces.git",
    "directory": "packages/browser"
  },
  "homepage": "https://github.com/klarkxy/dsh-spaces/tree/main/packages/browser",
  "bugs": {
    "url": "https://github.com/klarkxy/dsh-spaces/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "spaces",
    "browser"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  }
}
