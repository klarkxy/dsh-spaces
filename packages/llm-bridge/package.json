{
  "name": "@dsh-spaces/llm-bridge",
  "version": "0.4.0",
  "license": "MIT",
  "description": "Host-side bridge that projects Spaces shared LLM connections into a single Space's official settings and credentials seams",
  "author": "dsh-spaces",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarkxy/dsh-spaces.git",
    "directory": "packages/llm-bridge"
  },
  "homepage": "https://github.com/klarkxy/dsh-spaces/tree/main/packages/llm-bridge",
  "bugs": {
    "url": "https://github.com/klarkxy/dsh-spaces/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "spaces",
    "llm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials-local": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    },
    "@deepseek-ai/dsh-util-values": {
      "optional": true
    }
  }
}
