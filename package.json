{
  "name": "dsh-spaces",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Spaces for DeepSeek Harness — switch DSH workspaces like Discord servers.",
  "repository": {
    "type": "git",
    "url": "https://github.com/klarkxy/dsh-spaces.git"
  },
  "homepage": "https://github.com/klarkxy/dsh-spaces",
  "bugs": {
    "url": "https://github.com/klarkxy/dsh-spaces/issues"
  },
  "author": "dsh-spaces",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "tsx --test tests/profile-registry.test.ts tests/patch-writer.test.ts tests/write-paths.test.ts tests/dsh-cli.test.ts tests/package-source.test.ts tests/toolchain.test.ts tests/i18n.test.ts tests/plugin-catalog.test.ts tests/plugin-ops.test.ts tests/plugin-library.test.ts tests/process-manager.test.ts tests/restore-selected.test.ts tests/diagnostics.test.ts tests/runtime-store.test.ts tests/snapshot-store.test.ts tests/restore-session.test.ts tests/frontend-recovery.test.ts tests/package-build.test.ts tests/maintenance-gate.test.ts tests/coordinated-upgrade.test.ts tests/terminate-process.test.ts tests/dsh-endpoint.test.ts tests/space-icon.test.ts",
    "validate:isolation": "node scripts/validate-isolation.mjs --clean",
    "validate:lifecycle": "node scripts/verify-lifecycle.mjs",
    "validate:a8": "node scripts/verify-a8.mjs",
    "setup:sandbox": "node scripts/setup-sandbox.mjs",
    "smoke": "npm run build && node scripts/run-smoke.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "electron-updater": "^6.6.2",
    "js-yaml": "^4.2.0",
    "lucide-react": "^0.542.0",
    "motion": "^12.23.12",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "dev.dshspaces.app",
    "productName": "DSH Spaces",
    "copyright": "Copyright © 2026 DSH Spaces contributors",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "out/main/snapshot-worker.mjs",
      "out/main/chunks/**"
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "resources/mac-icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "publish": {
      "provider": "github",
      "owner": "klarkxy",
      "repo": "dsh-spaces",
      "releaseType": "release"
    }
  }
}
