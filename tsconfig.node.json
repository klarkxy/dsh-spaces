{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "src/core/**/*",
    "src/adapters/**/*",
    "packages/plugin/src/host/**/*",
    "packages/plugin/src/types.ts",
    "packages/llm-bridge/src/activity-protocol.ts",
    "src/shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "src/shared/ui/**/*"
  ]
}
