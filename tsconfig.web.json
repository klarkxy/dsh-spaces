{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@workbench/*": [
        "packages/plugin/src/workbench/*"
      ]
    }
  },
  "include": [
    "src/shared/**/*",
    "src/core/domain/llm-resolution.ts",
    "src/core/domain/blueprint.ts",
    "packages/plugin/src/workbench/**/*"
  ]
}
